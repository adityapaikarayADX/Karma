{
  "name": "astra-ai",
  "version": "0.2.0",
  "private": true,
  "description": "A general-purpose conversational AI workspace.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "build:desktop": "pnpm build && node scripts/stage-desktop.mjs",
    "tauri": "tauri",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "benchmark:chat": "node scripts/benchmark-chat.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "docx": "^9.13.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "next": "16.4.2",
    "openai": "7.40.0",
    "pdfjs-dist": "^6.4.299",
    "pdfkit": "^0.20.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.5.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
